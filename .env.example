# Токен бота: https://discord.com/developers/applications -> ваш бот -> Bot -> Reset Token
DISCORD_TOKEN=

# Ключ DeepL: https://www.deepl.com/your-account/keys (ключ бесплатного тарифа оканчивается на ":fx")
DEEPL_API_KEY=

# ID каналов через запятую, где бот переводит. Пусто = во всех каналах, куда у бота есть доступ
ALLOWED_CHANNEL_IDS=

# Через сколько секунд удалять сообщение с переводом (0 = не удалять)
TRANSLATION_DELETE_AFTER=0
